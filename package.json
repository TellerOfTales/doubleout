{
  "name": "doubleout",
  "version": "1.0.0",
  "private": true,
  "description": "DOUBLE OUT - a single-player darts roguelite. 2D pixel art, zero assets, zero cost.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "genart": "node --experimental-strip-types tools/genart.ts",
    "build": "npm run genart && tsc --noEmit -p tsconfig.json && vite build && node --experimental-strip-types tools/singlefile.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "balance": "vite-node tools/balance.ts",
    "balance:pairs": "vite-node tools/balance.ts --pairs",
    "screenshots": "node --experimental-strip-types tools/screenshot.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "decisions": "vite-node tools/decisions.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
